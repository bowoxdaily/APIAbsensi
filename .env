HRIS_PUSH_RETRY_MAX=2
HRIS_PUSH_RETRY_DELAY_MS=1000
HRIS_PUSH_TIMEOUT_MS=5000
# Kirim juga saat cron pull (dedup otomatis, tidak double jika webhook sudah kirim)
HRIS_PUSH_FROM_CRON=true
HRIS_DELIVERED_KEYS_MAX=5000

# -----------------------------------------------------------------------------
# ATTLOG PULL CRON (disarankan aktifkan — pull langsung dari API Fingerspot)
# -----------------------------------------------------------------------------
# Aktifkan pull attlog otomatis dari API Fingerspot ke Supabase
ENABLE_ATTLOG_CRON=true
# Interval pull dalam menit (disarankan: 15 menit)
ATTLOG_CRON_INTERVAL_MINUTES=15
# Lookback: berapa jam ke belakang yang di-pull setiap siklus (2 jam = aman overlap)
ATTLOG_CRON_LOOKBACK_HOURS=1
# Jeda antar mesin dalam ms agar tidak flood API (default: 2000ms)
ATTLOG_CRON_DELAY_MS=3000

# Scheduler sync antar mesin (opsional)
ENABLE_SYNC_CRON=false
SYNC_CRON_INTERVAL_MINUTES=10
SYNC_SOURCE_CLOUD_ID=S118000033
SYNC_TARGET_CLOUD_ID=GQ5179635
SYNC_LIMIT=300
SYNC_CONCURRENCY=1
SYNC_DRY_RUN=false
SYNC_TRANS_PREFIX=sync-cron

# Opsi scalable job sync banyak pasangan sekaligus (override single job di atas)
# Contoh:
# SYNC_JOBS_JSON=[{"source_cloud_id":"GQ5179635","target_cloud_id":"GQ5778665","trans_prefix":"sync-1-2","limit":1000,"concurrency":3,"dry_run":false},{"source_cloud_id":"GQ1234567","target_cloud_id":"GQ5778665","trans_prefix":"sync-3-2","limit":1000,"concurrency":3,"dry_run":false}]
